#!/usr/bin/env bash
# finish-ticket — check whether a ticket is ready for PR. Never commits, pushes, or merges.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: finish-ticket [TICKET-ID] [options]

  1. verifies git state of the ticket worktree (branch, status, conflicts)
  2. runs the validation commands it can detect
  3. inspects the diff against the base branch (changed files, debug code, TODOs)
  4. writes .work/<ID>/validation.md and drafts implementation-report.md if missing
  5. reports whether the ticket is ready for PR

TICKET-ID defaults to the ID in the current branch name.

Options:
  --base REF        compare against REF instead of workspace.base in ticket.md
  --no-validate     skip running validation commands (result: not ready)
  --full-tests      run the full test suite instead of only affected tests
  -h, --help        show this help

Validation commands, in order of precedence:
  .agent2793/validation in the repository  (lines "name: command"; see below)
  package.json scripts   typecheck, lint, format:check, test, build
  Makefile targets       typecheck, lint, test, build
  go.mod                 go vet ./..., go test ./..., go build ./...
  Cargo.toml             cargo test, cargo build

Tests follow the standard practice: affected tests locally, full suite in CI.
  - Affected tests run when the package.json test script is a plain vitest/jest call
    (vitest related / jest --findRelatedTests on the changed source files).
  - The full suite runs instead when: dependencies, test config, or tsconfig changed;
    the test script has env vars, wrappers, or config/project flags; the repository
    has no CI configuration (nothing else would run it); tests-scope is full; or
    --full-tests is given.
  - Typecheck, lint, and build always cover the whole project.

.agent2793/validation lines:
  name: command            a check (if any are present, they replace automatic detection)
  name: cmd {files}        {files} = changed source files (affected tests)
  name-full: command       used instead of the {files} line when the full suite is required
  tests-scope: full        always run the full suite (default: affected)

Exit status: 0 ready for PR, 2 not ready, 1 error.
EOF
}

id="" base_opt="" validate=1 full_tests=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --base) base_opt=${2:?--base needs a value}; shift 2 ;;
    --no-validate) validate=0; shift ;;
    --full-tests) full_tests=1; shift ;;
    -h | --help) usage; exit 0 ;;
    -*) ea_die "unknown option '$1' (see --help)" ;;
    *) [[ -z "$id" ]] || ea_die "unexpected argument '$1'"; id=$1; shift ;;
  esac
done

ea_require_git_repo
main=$(ea_main_worktree)
if [[ -z "$id" ]]; then
  id=$(ea_ticket_id_from_branch "$(git branch --show-current)") ||
    ea_die "cannot infer ticket id from branch '$(git branch --show-current)'; pass it explicitly"
fi
ea_validate_ticket_id "$id"

context="$main/.work/$id"
ticket="$context/ticket.md"
[[ -f "$ticket" ]] || ea_die "no ticket context at $ticket (run start-ticket first)"

worktree=$(ea_ticket_field "$ticket" worktree)
branch=$(ea_ticket_field "$ticket" branch)
base=${base_opt:-$(ea_ticket_field "$ticket" base)}
title=$(ea_ticket_field "$ticket" title)
status=$(ea_ticket_field "$ticket" status)
[[ -d "$worktree" ]] || ea_die "worktree '$worktree' from ticket.md does not exist"
cd "$worktree" || exit 1

blockers=()
warnings=()

# --- 1. Git state ------------------------------------------------------------------------------
current=$(git branch --show-current)
[[ "$current" == "$branch" ]] || blockers+=("worktree is on '$current', expected '$branch'")

case "$status" in
  BLOCKED | CANCELLED) blockers+=("ticket status is $status") ;;
esac

merge_base=$(git merge-base "$base" HEAD 2>/dev/null) || ea_die "cannot find merge base between '$base' and HEAD"

unmerged=$(git diff --name-only --diff-filter=U 2>/dev/null)
[[ -z "$unmerged" ]] || blockers+=("unmerged files: $(echo "$unmerged" | tr '\n' ' ')")

uncommitted=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
[[ "$uncommitted" -eq 0 ]] || warnings+=("$uncommitted uncommitted path(s) — commit before opening the PR")

# Changed files: tracked changes vs. merge base (committed + uncommitted), plus untracked files.
changed=$(git diff --name-status "$merge_base" -- 2>/dev/null)
untracked=$(git ls-files --others --exclude-standard)
files_md=""
while IFS=$'\t' read -r st file rest; do
  [[ -n "$st" ]] || continue
  files_md+="- \`$st\` ${rest:-$file}"$'\n'
done <<<"$changed"
while IFS= read -r file; do
  [[ -n "$file" ]] && files_md+="- \`??\` $file (untracked)"$'\n'
done <<<"$untracked"
[[ -n "$files_md" ]] || blockers+=("no changes compared to $base")

# --- 2. Diff inspection --------------------------------------------------------------------------
added_lines() {
  git diff -U0 --no-color "$merge_base" -- 2>/dev/null |
    awk '/^\+\+\+ / { f = substr($0, 7); next } /^\+/ { print f ":\t" substr($0, 2) }'
  if [[ -n "$untracked" ]]; then
    while IFS= read -r file; do
      grep -IHn '' -- "$file" 2>/dev/null | sed 's/:\([0-9]*\):/:\t/'
    done <<<"$untracked"
  fi
}
all_added=$(added_lines)
markers=$(grep -E $'\t(<<<<<<<|>>>>>>>)( |$)' <<<"$all_added" || true)
debug=$(grep -E 'console\.(log|debug)\(|debugger;?$|\.only\(|(^|[^A-Za-z_])(fit|fdescribe|xit|xdescribe)\(|\.skip\(' <<<"$all_added" || true)
todos=$(grep -E 'TODO|FIXME|XXX' <<<"$all_added" || true)
[[ -z "$markers" ]] || blockers+=("conflict markers in added lines")
[[ -z "$debug" ]] || warnings+=("possible debug code or focused/skipped tests — review")
[[ -z "$todos" ]] || warnings+=("added TODO/FIXME — ensure each references a ticket")

[[ -f "$context/review.md" ]] || blockers+=("self-review not recorded (.work/$id/review.md missing)")

blocked_by=$(awk '/^[[:space:]]*blocked_by:/ { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "$ticket")
[[ -z "$blocked_by" || "$blocked_by" == "[]" ]] || warnings+=("ticket is blocked_by $blocked_by — confirm those are merged")

# --- 3. Validation -------------------------------------------------------------------------------
names=() cmds=() results=() notes=()
add_check() { names+=("$1"); cmds+=("$2"); results+=("${3:-}"); notes+=("${4:-}"); }

# Files the ticket changed (existing ones), and the source files among them, for affected tests.
changed_paths=()
while IFS= read -r p; do
  [[ -n "$p" ]] && changed_paths+=("$p")
done < <(git diff --name-only --diff-filter=d "$merge_base" -- 2>/dev/null; printf '%s\n' "$untracked")
code_files=()
for p in "${changed_paths[@]}"; do
  [[ "$p" =~ \.(m?[jt]sx?|c[jt]s|vue|svelte)$ ]] && code_files+=("$p")
done
files_q=$(printf '%q ' "${code_files[@]}")
files_q=${files_q% }

# Project settings and command overrides: .agent2793/validation ("name: command" lines).
override=".agent2793/validation"
override_value() { # value of "<key>:" in the override file, if any
  [[ -f "$override" ]] || return 0
  awk -v key="$1" '
    $0 ~ "^[[:space:]]*" key "[[:space:]]*:" { sub("^[^:]*:[[:space:]]*", ""); sub("[[:space:]]+$", ""); print; exit }
  ' "$override"
}
tests_scope=$(override_value tests-scope)
case "${tests_scope:-affected}" in
  affected | full) ;;
  *) ea_die "$override: tests-scope must be 'affected' or 'full', got '$tests_scope'" ;;
esac

# CI is the gate that runs the full suite. Without CI configuration, nothing does: run it here.
has_ci=0
for p in .github/workflows/*.yml .github/workflows/*.yaml .gitlab-ci.yml azure-pipelines.yml \
  .circleci/config.yml Jenkinsfile bitbucket-pipelines.yml .buildkite .drone.yml .travis.yml; do
  if [[ -e "$p" ]]; then has_ci=1; break; fi
done
[[ $has_ci -eq 1 ]] || warnings+=("no CI configuration found — the full test suite ran locally because nothing else gates the PR")

# When the full suite is required instead of affected tests, print why.
full_trigger_re='(^|/)(package\.json|pnpm-lock\.yaml|package-lock\.json|yarn\.lock|bun\.lockb?|tsconfig[^/]*\.json|(vite|vitest|jest)\.(config|setup|workspace)[^/]*|setupTests\.[cm]?[jt]sx?|babel\.config\.[^/]+|\.babelrc)$|(^|/)__mocks__/'
full_suite_reason() {
  local p
  if [[ $full_tests -eq 1 ]]; then echo "--full-tests"; return; fi
  if [[ "$tests_scope" == full ]]; then echo "project setting tests-scope: full"; return; fi
  if [[ $has_ci -eq 0 ]]; then echo "no CI configuration found"; return; fi
  for p in "${changed_paths[@]}"; do
    if [[ "$p" =~ $full_trigger_re ]]; then echo "$p changed"; return; fi
  done
  if [[ ${#code_files[@]} -gt 200 ]]; then echo "${#code_files[@]} changed source files"; fi
}
full_reason=$(full_suite_reason)

# Override checks. A command with {files} runs on the changed source files; when the full suite
# is required, its "<name>-full:" line runs instead. Settings (tests-scope) and -full lines are
# not checks themselves. If the file defines no checks, automatic detection is used.
override_checks() {
  [[ -f "$override" ]] || return 1
  local line name cmd full_cmd found=1
  while IFS= read -r line || [[ -n "$line" ]]; do
    line=${line%$'\r'}
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    name=$(sed 's/:.*//; s/[[:space:]]*$//; s/^[[:space:]]*//' <<<"$line")
    cmd=$(sed 's/^[^:]*:[[:space:]]*//' <<<"$line")
    [[ "$name" == tests-scope || "$name" == *-full ]] && continue
    found=0
    if [[ "$cmd" != *"{files}"* ]]; then
      add_check "$name" "$cmd"
    elif [[ -n "$full_reason" ]]; then
      full_cmd=$(override_value "$name-full")
      if [[ -n "$full_cmd" ]]; then
        add_check "$name" "$full_cmd" "" "full suite ($full_reason)"
      else
        add_check "$name" "$cmd" "NOT RUN" "full suite required ($full_reason) but no '$name-full:' command in $override"
      fi
    elif [[ ${#code_files[@]} -eq 0 ]]; then
      add_check "$name" "$cmd" "N/A" "no changed source files"
    else
      add_check "$name" "${cmd//"{files}"/"$files_q"}" "" "affected tests of ${#code_files[@]} changed file(s)"
    fi
  done <"$override"
  return $found
}

# Affected-test command for a package.json test script, only when the script is a plain
# vitest/jest invocation. Env vars, wrappers, or config/project flags change how tests run;
# calling the runner directly would drop them, so those scripts get the full suite instead.
affected_test_command() {
  local body=$1 exec_prefix=$2 runner rest tok
  read -r runner rest <<<"$body"
  case "$runner" in
    vitest)
      [[ "$rest" == run || "$rest" == "run "* ]] && rest=${rest#run}
      for tok in $rest; do
        case "$tok" in
          --run | --silent | --coverage | --no-coverage | --passWithNoTests | --reporter=* | --color | --no-color | --bail=*) ;;
          *) return 1 ;;
        esac
      done
      echo "$exec_prefix vitest related --run --passWithNoTests $files_q"
      ;;
    jest)
      for tok in $rest; do
        case "$tok" in
          --ci | --silent | --coverage | --passWithNoTests | --runInBand | -i | --verbose | --watchAll=false | --bail | --color | --no-color) ;;
          *) return 1 ;;
        esac
      done
      echo "$exec_prefix jest --ci --findRelatedTests --passWithNoTests $files_q"
      ;;
    *) return 1 ;;
  esac
}

detect_checks() {
  override_checks && return

  if [[ -f package.json ]]; then
    local pm=npm
    [[ -f pnpm-lock.yaml ]] && pm=pnpm
    [[ -f yarn.lock ]] && pm=yarn
    [[ -f bun.lockb || -f bun.lock ]] && pm=bun
    if ! command -v node >/dev/null; then
      add_check "package.json" "-" "NOT RUN" "node not found"
      return
    fi
    local scripts_tsv scripts
    scripts_tsv=$(node -e 'const s = require("./package.json").scripts || {}; for (const k of Object.keys(s)) console.log(k + "\t" + String(s[k]).replace(/[\t\n]/g, " "))')
    scripts=$(cut -f1 <<<"$scripts_tsv")
    local exec_prefix
    case "$pm" in
      pnpm) exec_prefix="pnpm exec" ;;
      yarn) exec_prefix="yarn" ;;
      bun) exec_prefix="bunx" ;;
      *) exec_prefix="npx --no-install" ;;
    esac
    local check name candidates s found script_body
    for check in "typecheck:typecheck type-check check-types tsc" "lint:lint" \
      "format:format:check fmt:check prettier:check check-format" "tests:test test:unit" "build:build"; do
      name=${check%%:*}
      candidates=${check#*:}
      found=""
      for s in $candidates; do
        if grep -qxF "$s" <<<"$scripts"; then found=$s; break; fi
      done
      [[ -n "$found" ]] || continue
      if [[ ! -d node_modules ]]; then
        add_check "$name" "$pm run $found" "NOT RUN" "dependencies not installed (node_modules missing)"
        continue
      fi
      if [[ "$name" != tests ]]; then
        add_check "$name" "$pm run $found"
        continue
      fi
      # Tests: only those affected by the changed files, when that can be done faithfully.
      script_body=$(awk -F'\t' -v k="$found" '$1 == k { print $2; exit }' <<<"$scripts_tsv")
      local affected_cmd
      if [[ -n "$full_reason" ]]; then
        add_check tests "$pm run $found" "" "full suite ($full_reason)"
      elif [[ ${#code_files[@]} -eq 0 ]]; then
        add_check tests "-" "N/A" "no changed source files"
      elif affected_cmd=$(affected_test_command "$script_body" "$exec_prefix"); then
        add_check tests "$affected_cmd" "" "affected tests of ${#code_files[@]} changed file(s)"
      else
        add_check tests "$pm run $found" "" "full suite (\"$found\" script is not a plain vitest/jest call)"
      fi
    done
    for s in test:integration test:e2e e2e build-storybook storybook:build build:storybook; do
      grep -qxF "$s" <<<"$scripts" && add_check "$s" "$pm run $s" "NOT RUN" "not run by finish-ticket; run it if the ticket requires it"
    done
    return
  fi

  if [[ -f Makefile ]] && command -v make >/dev/null; then
    local t
    for t in typecheck lint test build; do
      grep -qE "^$t:" Makefile && add_check "$t" "make $t"
    done
    return
  fi

  if [[ -f go.mod ]] && command -v go >/dev/null; then
    add_check lint "go vet ./..."
    add_check tests "go test ./..."
    add_check build "go build ./..."
    return
  fi

  if [[ -f Cargo.toml ]] && command -v cargo >/dev/null; then
    add_check tests "cargo test"
    add_check build "cargo build"
  fi
}

detect_checks
mkdir -p "$context/logs"
ran=0
for i in "${!names[@]}"; do
  [[ -z "${results[$i]}" ]] || continue
  if [[ $validate -eq 0 ]]; then
    results[i]="NOT RUN"
    notes[i]="--no-validate"
    continue
  fi
  log="$context/logs/$(tr -c 'A-Za-z0-9_.-' '_' <<<"${names[$i]}" | sed 's/_*$//').log"
  printf 'Running %-12s %s\n' "${names[$i]}" "${cmds[$i]}"
  start=$SECONDS
  if CI=true bash -c "${cmds[$i]}" >"$log" 2>&1; then
    results[i]="PASS"
  else
    results[i]="FAIL"
  fi
  notes[i]="${notes[i]:+${notes[i]}; }$((SECONDS - start))s, log: logs/$(basename "$log")"
  ran=$((ran + 1))
done

for i in "${!names[@]}"; do
  if [[ "${results[$i]}" == "PASS" && "${notes[$i]}" == affected* ]]; then
    warnings+=("${names[$i]}: only affected tests ran locally — the full suite runs in CI (or use --full-tests)")
  fi
done

if [[ ${#names[@]} -eq 0 ]]; then
  blockers+=("no validation commands detected — add .agent2793/validation or validate manually")
elif [[ $validate -eq 0 ]]; then
  blockers+=("validation skipped (--no-validate)")
else
  blockers_before=${#blockers[@]}
  for i in "${!names[@]}"; do
    case "${results[$i]}" in
      FAIL) blockers+=("${names[$i]} failed (${cmds[$i]})") ;;
      "NOT RUN")
        if [[ "${notes[$i]}" == "not run by finish-ticket"* ]]; then
          warnings+=("${names[$i]} not run — run it if the ticket requires it")
        else
          blockers+=("${names[$i]} could not run: ${notes[$i]}")
        fi
        ;;
    esac
  done
  if [[ $ran -eq 0 && ${#blockers[@]} -eq $blockers_before ]]; then
    blockers+=("no required validation command ran")
  fi
fi

# --- 4. Write validation.md and the report draft -------------------------------------------------
table="| Check | Command | Result | Notes |"$'\n'"|---|---|---|---|"$'\n'
summary=""
for i in "${!names[@]}"; do
  table+="| ${names[$i]} | \`${cmds[$i]}\` | ${results[$i]} | ${notes[$i]} |"$'\n'
  summary+="- ${names[$i]}: ${results[$i]} (\`${cmds[$i]}\`)"$'\n'
done
[[ -n "$summary" ]] || summary="- No validation commands detected."$'\n'

if [[ ${#blockers[@]} -eq 0 ]]; then verdict="READY_FOR_PR"; else verdict="NOT READY"; fi

fmt_list() { if [[ $# -eq 0 ]]; then echo "- None"; else printf -- '- %s\n' "$@"; fi; }
fmt_block() { if [[ -z "$1" ]]; then echo "None"; else printf '```text\n%s\n```\n' "$1"; fi; }

{
  echo "# Validation: $id"
  echo
  echo "Generated by scripts/finish-ticket on $(date '+%Y-%m-%d %H:%M'). Branch \`$current\`, base \`$base\` (merge base \`${merge_base:0:10}\`)."
  echo
  printf '%s' "$table"
  echo
  echo "## Changed Files"
  echo
  printf '%s' "${files_md:-None}"
  echo
  echo "## Review Items"
  echo
  echo "Debug code / focused or skipped tests:"
  fmt_block "$debug"
  echo
  echo "TODO / FIXME:"
  fmt_block "$todos"
  echo
  echo "## Result: $verdict"
  echo
  echo "Blockers:"
  fmt_list "${blockers[@]}"
  echo
  echo "Warnings:"
  fmt_list "${warnings[@]}"
} >"$context/validation.md"

report="$context/implementation-report.md"
# The draft is created once, only when there is something real to report; it is never overwritten,
# because the agent completes it by hand. validation.md is always current.
if [[ -f "$report" ]]; then
  report_note="kept existing — update its Validation section from validation.md"
elif [[ $ran -eq 0 || -z "$files_md" ]]; then
  report_note="not created yet — needs changes and at least one validation run"
else
  ea_render "$EA_HOME/templates/implementation-report.md" \
    "ID=$id" "TITLE=$title" "FILES=${files_md%$'\n'}" "VALIDATION=${summary%$'\n'}" >"$report"
  report_note="draft created — the agent completes Summary, Changes, Review, Limitations, Follow-ups"
fi

# --- 5. Report -----------------------------------------------------------------------------------
cat <<EOF

Ticket:     $id — $title
Worktree:   $worktree
Branch:     $current (base $base)

Validation:
$summary
Validation record:      $context/validation.md
Implementation report:  $report ($report_note)

Blockers:
$(fmt_list "${blockers[@]}")

Warnings:
$(fmt_list "${warnings[@]}")

Result: $verdict
EOF

if [[ "$verdict" == "READY_FOR_PR" ]]; then
  echo "The agent may set ticket.status to READY_FOR_PR after completing the implementation report,"
  echo "then comments on the tracker ticket per tracker.comment in ticket.md (ticket/finish.md §4)."
  echo "Nothing was committed, pushed, or merged."
  exit 0
fi
exit 2
